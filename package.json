{
  "name": "yuri4n.dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter ./playground run dev",
    "dev:docs": "pnpm --filter ./playground-docs run dev",
    "build": "pnpm --filter ./playground run build && pnpm --filter ./playground-docs run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p packages/eslint-config && pnpm --filter ./playground run typecheck && pnpm --filter ./playground-docs run typecheck",
    "test": "node --test \"layers/*/test/*.test.mts\" \"layers/*/test/*.test.mjs\" \"packages/*/test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@yuri4n/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3"
  }
}
